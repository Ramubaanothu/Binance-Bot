[Unit]
Description=Publish per-book equity for the cross-book exposure cap
After=network-online.target
[Service]
Type=oneshot
User=bots
ExecStart=/home/bots/venv/bin/python /home/bots/shared/publish_equity.py
[Unit]
Description=Refresh per-book equity every minute
[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=10s
[Install]
WantedBy=timers.target
