# Copy to .env and fill in. Never commit .env.

# ── Your Telegram account (reads the loot channels) ───────────────────────
# my.telegram.org -> API development tools -> create an app
TG_API_ID=
TG_API_HASH=

# ── The bot that alerts you (so your phone rings) ─────────────────────────
# @BotFather -> /newbot. Send your new bot any message first, then get your
# chat id from @userinfobot. Leave empty to get alerts in Saved Messages
# instead (silent, no notification).
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ── What to watch ─────────────────────────────────────────────────────────
# Comma-separated @usernames or ids (python -m dealbot channels lists them).
# Empty = every channel your account has joined.
CHANNELS=

MIN_DISCOUNT=90
PLATFORMS=amazon,flipkart
# Alert on "price error" / "glitch" posts even when no % can be read.
ALERT_ON_GLITCH_WORDS=true
# Same product at the same price is alerted once per this many hours.
DEDUPE_HOURS=6

# ── Amazon auto-order (paid from Amazon Pay balance only) ─────────────────
# Orders Amazon deals at >= MIN_DISCOUNT automatically. You review each
# order in the Amazon app afterwards and cancel the ones you don't want.
# Needs Amazon login cookies: python -m dealbot amazon-cookies <file>
AUTO_ORDER=true
# true = go up to "Place your order", screenshot it, and stop (testing).
ORDER_DRY_RUN=false
# Your Amazon Pay balance is always the hard limit: an order is placed only
# if the balance covers the WHOLE total, so it never touches card/UPI.
# Optional extra caps (0 = off):
MAX_ORDER_PRICE=0
MAX_ORDERS_PER_DAY=0
# Leave empty to use Playwright's own Chromium.
CHROMIUM_PATH=
