# Copy to .env and fill in. Never commit .env.

# ── Your Telegram account (reads the loot channels) ───────────────────────
# my.telegram.org -> API development tools -> create an app
TG_API_ID=
TG_API_HASH=

# ── The bot that alerts you (so your phone rings) ─────────────────────────
# @BotFather -> /newbot. Send your new bot any message first, then get your
# chat id from @userinfobot. Leave empty to get alerts in Saved Messages
# instead (silent, no notification).
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ── What to watch ─────────────────────────────────────────────────────────
# Comma-separated @usernames or ids (python -m dealbot channels lists them).
# Empty = every channel your account has joined.
CHANNELS=

MIN_DISCOUNT=90
PLATFORMS=amazon,flipkart
# Alert on "price error" / "glitch" posts even when no % can be read.
ALERT_ON_GLITCH_WORDS=true
# Same product at the same price is alerted once per this many hours.
DEDUPE_HOURS=6
